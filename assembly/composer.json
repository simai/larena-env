        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.8",
        "larena/access": "dev-main#5cce157c3f34888f4f13db928ce216200821a3cc",
        "larena/admin": "dev-main#c294da785e8044b963a572381d80ddb056c04ab5",
        "larena/audit": "dev-main#dd1aff00e7b5c5b4df862507458033221f04faab",
        "larena/auth": "dev-main#e302e23df39f9fec47e180365c3ac59b81fa59d6",
        "larena/core": "dev-main#bac9b420e3d63de78b235886ef97e3d86d98eed7",
        "larena/dataview": "dev-main#f81e8078c710033b2fd0bc596b94687cd9991ec6",
        "larena/env": "dev-main",
        "larena/filesystem": "dev-main#de6158f374561dd7fa6a29b98bf7ea6fb2e197b1",
        "larena/notification": "dev-main#2fedbb26e3ba6f887cb2e3b96a10bbdd88cd4fee",
        "larena/property": "dev-main#92e41c046420ff82b775daf6cf3ab28e234e27fd",
        "larena/setting": "dev-main#7c91380813dddd23f4171a0c8e6e566c922fd84b",
        "larena/ui": "dev-main#e9b29e30e97e042ae3caea6936549ca22617030c"
    },
    "repositories": [
        {"type": "path", "url": "../env-source", "options": {"symlink": false, "reference": "none", "versions": {"larena/env": "dev-main"}}},
        {"type": "vcs", "url": "https://github.com/simai/larena-access.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-admin.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-audit.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-auth.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-core.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-dataview.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-filesystem.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-notification.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-property.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-setting.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-ui.git"}
    ],
    "extra": {
        "laravel": {
            "dont-discover": ["larena/auth", "larena/setting"]
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.31"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

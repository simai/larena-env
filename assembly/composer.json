        "ext-session": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.8",
        "larena/access": "dev-main#d612683795774996a2135e5db9c9d538138fc9cf",
        "larena/admin": "dev-main#2c36c05e5f35fc73b4c7e51df25459091f9bd69a",

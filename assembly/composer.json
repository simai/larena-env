    "repositories": [
        {"type": "path", "url": "../env-source", "options": {"symlink": false, "reference": "none", "versions": {"larena/env": "dev-main"}}},
        {"type": "vcs", "url": "https://github.com/simai/larena-access.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-admin.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-audit.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-auth.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-core.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-dataview.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-filesystem.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-notification.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-property.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-setting.git"},

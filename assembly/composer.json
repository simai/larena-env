        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.8",
        "larena/access": "dev-main#8053f9dc4ed782da2d44fbeb86a1074eee77dd47",
        "larena/admin": "dev-main#a3172a2569d58874e71ab8e65e4914b6de9a4122",
        "larena/audit": "dev-main#b68f08cd534d8a874291a258bd58a582d6fa2476",
        "larena/auth": "dev-main#dffb03db7ec2fed72e29695cd2b9052daf9757b5",
        "larena/core": "dev-main#359416eb1aea28386ae9db20a68c5edc9bd86491",
        "larena/dataview": "dev-main#a7bcdb1163d7e3c2876136cbb78a994930a394bb",
        "larena/env": "dev-main",
        "larena/filesystem": "dev-main#0516a162e10a02b35f872574034374e25d1398f7",
        "larena/notification": "dev-main#70e9ac626686ab9028de85b3bc3fd8a788872d28",
        "larena/property": "dev-main#0ed99741344ecb88568053d2d11daaa1d3b44cb0",
        "larena/setting": "dev-main#6ef989a5d6aba5a06dff9389ea6b0b6bcf44296f",
        "larena/ui": "dev-main#670e5cd545d642eee360cfe0f0fb80e1f73c0729"
    },
    "repositories": [
        {"type": "path", "url": "../env-source", "options": {"symlink": false, "reference": "none", "versions": {"larena/env": "dev-main"}}},
        {"type": "vcs", "url": "https://github.com/simai/larena-access.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-admin.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-audit.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-auth.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-core.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-dataview.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-filesystem.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-notification.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-property.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-setting.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-ui.git"}
    ],
    "extra": {
        "laravel": {
            "dont-discover": ["larena/auth", "larena/setting"]
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.31"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

        "larena/filesystem": "dev-main#0516a162e10a02b35f872574034374e25d1398f7",
        "larena/notification": "dev-main#70e9ac626686ab9028de85b3bc3fd8a788872d28",
        "larena/property": "dev-main#0315524951d7f0adc8f532f664e6873185ae38f3",
        "larena/setting": "dev-main#6ef989a5d6aba5a06dff9389ea6b0b6bcf44296f",
        "larena/ui": "dev-main#1ef460b6bcaff1f53fb804adbe1f7347c93fdcde"

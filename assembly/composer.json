        "larena/env": "dev-main",
        "larena/filesystem": "dev-main#0516a162e10a02b35f872574034374e25d1398f7",
        "larena/notification": "dev-main#5991c903ec083e8ada15463e7da75839b5709d50",
        "larena/property": "dev-main#6a8b5895d03b7c6e0492ebded943fc1410104e23",
        "larena/setting": "dev-main#6a165243fd51d3f958b3dedfe9daf40248ad0e42",
        "larena/ui": "dev-main#9c975c230c278ae26488a3a793152f82915d7047"

        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.8",
        "larena/access": "dev-main#a7bea8cb781a8ac479772f88e8e8ec6a77cb8e4c",
        "larena/admin": "dev-main#95852efb3d015ee9330686260a7690beb3fb7507",
        "larena/audit": "dev-main#14c241f348904ec1d29c9428ad63bdfa894193c8",
        "larena/auth": "dev-main#9dc2b2787677052d4c87a976ede3b502caf6e47e",
        "larena/core": "dev-main#359416eb1aea28386ae9db20a68c5edc9bd86491",
        "larena/dataview": "dev-main#9e18f3f120f3c9db74bedaf5655a8e90d74e62e2",
        "larena/env": "dev-main",
        "larena/filesystem": "dev-main#6873c1a2e94aaf015baeb21deac76d91825f05fe",
        "larena/notification": "dev-main#6383db6bf29a83f8e938d9c183a9bc13377549a7",
        "larena/property": "dev-main#67ec9ef3cb3691834814a54f5b9fb12a2cea2661",
        "larena/setting": "dev-main#bceabdd45062fefdcaec176238342f943dab5353",
        "larena/ui": "dev-main#50a7f478bd2a22be6bc0e787318717c6f3cdc95d"

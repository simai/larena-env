{
    "name": "simai/larena-panel",
    "description": "Larena Panel: the application a release archive carries. Exact package revisions; built by scripts/build-panel-archive.sh.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "laravel/framework": "^13.8",
        "larena/access": "dev-main#635f227ab0f8888b2eababef7562063c0b6e7e24",
        "larena/admin": "dev-main#8c7ff9dc2ccd7a448d734561e2201d2ef780c2d9",
        "larena/audit": "dev-main#3465a523846437703ea5e28d5d03d574189d22d4",
        "larena/auth": "dev-main#225dfadfbd52fd911e3d2a2195d768eadf87270d",
        "larena/core": "dev-main#359416eb1aea28386ae9db20a68c5edc9bd86491",
        "larena/dataview": "dev-main#9e18f3f120f3c9db74bedaf5655a8e90d74e62e2",
        "larena/env": "dev-main",
        "larena/filesystem": "dev-main#6873c1a2e94aaf015baeb21deac76d91825f05fe",
        "larena/notification": "dev-main#70e9ac626686ab9028de85b3bc3fd8a788872d28",
        "larena/property": "dev-main#67ec9ef3cb3691834814a54f5b9fb12a2cea2661",
        "larena/setting": "dev-main#e33a0ce5d22c0690507576c2fa8eec6d48d53910",
        "larena/ui": "dev-main#eced1374ad57ddfa4a9934a0c8a8e253b62380d5"
    },
    "repositories": [
        {"type": "path", "url": "../env-source", "options": {"symlink": false, "reference": "none", "versions": {"larena/env": "dev-main"}}},
        {"type": "vcs", "url": "https://github.com/simai/larena-access.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-admin.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-audit.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-auth.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-core.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-dataview.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-filesystem.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-notification.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-property.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-setting.git"},
        {"type": "vcs", "url": "https://github.com/simai/larena-ui.git"}
    ],
    "extra": {
        "laravel": {
            "dont-discover": ["larena/auth", "larena/setting"]
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.31"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

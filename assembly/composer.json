    "extra": {
        "laravel": {
            "dont-discover": ["larena/auth", "larena/setting"]
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.31"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true

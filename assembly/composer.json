        "larena/filesystem": "dev-main#6873c1a2e94aaf015baeb21deac76d91825f05fe",
        "larena/notification": "dev-main#e281e1d713122e060408aeaafa31eeee4e240902",
        "larena/property": "dev-main#67ec9ef3cb3691834814a54f5b9fb12a2cea2661",
        "larena/setting": "dev-main#a6f023747472c8e39d89be1bcb61d0995606c611",

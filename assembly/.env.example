# Larena Panel. Only what the panel reads by itself; every value here is also its built-in default, so a server's .env
# needs nothing but the database. simai-env writes DB_* and SIMAI_PANEL_SETUP_TOKEN; the panel writes APP_KEY on its first
# start and removes the token when the first administrator exists.
APP_NAME="Larena Panel"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# sudo: the gateway on this server. ssh: a panel on another machine (LARENA_ENV_SSH_*). recorded: local and testing only.
LARENA_ENV_GATEWAY=sudo
